# Server-only configuration. Copy to .env.local and fill in real values.
REDIS_URL=rediss://default:password@your-redis-host:port/0
SESSION_ENCRYPTION_KEY=base64-encoded-32-byte-key
LINKEDIN_SESSION_ID=primary
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Public browser setting. In production leave blank for a same-origin Vercel API.
VITE_API_BASE_URL=http://127.0.0.1:8000
